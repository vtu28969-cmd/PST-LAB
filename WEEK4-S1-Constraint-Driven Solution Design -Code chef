import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
    public static void main(String[] args) throws java.lang.Exception
    {
        Scanner sc = new Scanner(System.in);

        if (!sc.hasNextInt()) return;
        int T = sc.nextInt();

        while (T--> 0) {
            String s = sc.next();
            int n = s.length();
            int[] freq = new int[26];

            // Increment frequency for the first half
            for (int i = 0; i < n / 2; i++) {
                freq[s.charAt(i) - 'a']++;
            }

            // Decrement frequency for the second half
            for (int i = (n + 1) / 2; i < n; i++) {
                freq[s.charAt(i) - 'a']--;
            }

            boolean lapindrome = true;

            // Check if all frequencies balance out to zero
            for (int i = 0; i < 26; i++) {
                if (freq[i] != 0) {
                    lapindrome = false;
                    break;
                }
            }

            if (lapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }

        sc.close();
    }
}
